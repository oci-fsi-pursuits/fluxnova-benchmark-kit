<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="https://finos.org/benchmarks/lab">
  <process id="lab_sequential" name="Sequential checks" isExecutable="true" camunda:historyTimeToLive="1">
    <startEvent id="start" name="Request"/>
    <serviceTask id="kyc" name="Simulated KYC" camunda:type="external" camunda:topic="lab-demo"/>
    <serviceTask id="risk" name="Simulated risk" camunda:type="external" camunda:topic="lab-demo"/>
    <endEvent id="done" name="Checks complete"/>
    <sequenceFlow id="s1" sourceRef="start" targetRef="kyc"/>
    <sequenceFlow id="s2" sourceRef="kyc" targetRef="risk"/>
    <sequenceFlow id="s3" sourceRef="risk" targetRef="done"/>
  </process>
</definitions>
