{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fluxnova-benchmarks:analysis:1.0",
  "title": "Benchmark run analysis",
  "type": "object",
  "required": ["schema_version", "run_id", "mode", "evidence_label", "status", "counts", "rates", "latency", "cost", "outcomes", "input_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"}, "run_id": {"type": "string"},
    "mode": {"enum": ["live", "fixture", "local-functional"]},
    "evidence_label": {"type": "string"},
    "status": {"enum": ["invalid", "failed", "inconclusive", "pass"]},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "rates": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
    "latency": {"type": "object"}, "cost": {"type": "object"},
    "outcomes": {"type": "array", "items": {"type": "object"}},
    "input_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}}
  }
}
