<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="https://finos.org/benchmarks/w02" id="w02_parallel">
  <process id="bench_w02_parallel" name="W02 parallel independent payment checks" isExecutable="true" camunda:historyTimeToLive="30">
    <startEvent id="start" name="Payment received">
      <outgoing>start_fork</outgoing>
    </startEvent>
    <serviceTask id="kyc_check" name="KYC screening" camunda:type="external" camunda:topic="bench-w02-checks">
      <incoming>fork_kyc</incoming>
      <outgoing>kyc_join</outgoing>
    </serviceTask>
    <serviceTask id="risk_check" name="Independent risk check" camunda:type="external" camunda:topic="bench-w02-checks">
      <incoming>fork_risk</incoming>
      <outgoing>risk_join</outgoing>
    </serviceTask>
    <serviceTask id="verify_settle" name="Verify both checks and settle" camunda:type="external" camunda:topic="bench-w02-checks">
      <incoming>join_verify</incoming>
      <outgoing>verify_decision</outgoing>
    </serviceTask>
    <exclusiveGateway id="decision" name="Outcome" default="blocked_flow">
      <incoming>verify_decision</incoming>
      <outgoing>settled_flow</outgoing>
      <outgoing>rejected_flow</outgoing>
      <outgoing>blocked_flow</outgoing>
    </exclusiveGateway>
    <endEvent id="settled" name="Exactly one effect">
      <incoming>settled_flow</incoming>
    </endEvent>
    <endEvent id="rejected" name="Rejected without effect">
      <incoming>rejected_flow</incoming>
    </endEvent>
    <endEvent id="blocked" name="Unknown blocks effect">
      <incoming>blocked_flow</incoming>
    </endEvent>
    <parallelGateway id="fork" name="Run independent checks">
      <incoming>start_fork</incoming>
      <outgoing>fork_kyc</outgoing>
      <outgoing>fork_risk</outgoing>
    </parallelGateway>
    <parallelGateway id="join" name="Wait for both">
      <incoming>kyc_join</incoming>
      <incoming>risk_join</incoming>
      <outgoing>join_verify</outgoing>
    </parallelGateway>
    <sequenceFlow id="start_fork" sourceRef="start" targetRef="fork" />
    <sequenceFlow id="fork_kyc" sourceRef="fork" targetRef="kyc_check" />
    <sequenceFlow id="fork_risk" sourceRef="fork" targetRef="risk_check" />
    <sequenceFlow id="kyc_join" sourceRef="kyc_check" targetRef="join" />
    <sequenceFlow id="risk_join" sourceRef="risk_check" targetRef="join" />
    <sequenceFlow id="join_verify" sourceRef="join" targetRef="verify_settle" />
    <sequenceFlow id="verify_decision" sourceRef="verify_settle" targetRef="decision" />
    <sequenceFlow id="settled_flow" sourceRef="decision" targetRef="settled">
      <conditionExpression xsi:type="tFormalExpression">${w02Outcome == 'settled'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="rejected_flow" sourceRef="decision" targetRef="rejected">
      <conditionExpression xsi:type="tFormalExpression">${w02Outcome == 'rejected'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="blocked_flow" sourceRef="decision" targetRef="blocked" />
  </process>
  <bpmndi:BPMNDiagram id="diagram_parallel">
    <bpmndi:BPMNPlane id="plane_parallel" bpmnElement="bench_w02_parallel">
      <bpmndi:BPMNShape id="start_shape" bpmnElement="start">
        <dc:Bounds x="42" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="14" y="213" width="92" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kyc_check_shape" bpmnElement="kyc_check">
        <dc:Bounds x="210" y="76" width="110" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="risk_check_shape" bpmnElement="risk_check">
        <dc:Bounds x="210" y="240" width="110" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verify_settle_shape" bpmnElement="verify_settle">
        <dc:Bounds x="445" y="158" width="125" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision_shape" bpmnElement="decision">
        <dc:Bounds x="610" y="165" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="582" y="220" width="106" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="settled_shape" bpmnElement="settled">
        <dc:Bounds x="722" y="72" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="694" y="113" width="92" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rejected_shape" bpmnElement="rejected">
        <dc:Bounds x="722" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="694" y="213" width="92" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="blocked_shape" bpmnElement="blocked">
        <dc:Bounds x="722" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="694" y="313" width="92" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork_shape" bpmnElement="fork">
        <dc:Bounds x="108" y="165" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="80" y="220" width="106" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_shape" bpmnElement="join">
        <dc:Bounds x="370" y="165" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="342" y="220" width="106" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="start_fork_edge" bpmnElement="start_fork">
        <di:waypoint x="78" y="190" />
        <di:waypoint x="108" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fork_kyc_edge" bpmnElement="fork_kyc">
        <di:waypoint x="133" y="165" />
        <di:waypoint x="133" y="108" />
        <di:waypoint x="210" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fork_risk_edge" bpmnElement="fork_risk">
        <di:waypoint x="133" y="215" />
        <di:waypoint x="133" y="272" />
        <di:waypoint x="210" y="272" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="kyc_join_edge" bpmnElement="kyc_join">
        <di:waypoint x="320" y="108" />
        <di:waypoint x="395" y="108" />
        <di:waypoint x="395" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="risk_join_edge" bpmnElement="risk_join">
        <di:waypoint x="320" y="272" />
        <di:waypoint x="395" y="272" />
        <di:waypoint x="395" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="join_verify_edge" bpmnElement="join_verify">
        <di:waypoint x="420" y="190" />
        <di:waypoint x="445" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="verify_decision_edge" bpmnElement="verify_decision">
        <di:waypoint x="570" y="190" />
        <di:waypoint x="610" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="settled_flow_edge" bpmnElement="settled_flow">
        <di:waypoint x="635" y="165" />
        <di:waypoint x="635" y="90" />
        <di:waypoint x="722" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="rejected_flow_edge" bpmnElement="rejected_flow">
        <di:waypoint x="660" y="190" />
        <di:waypoint x="722" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="blocked_flow_edge" bpmnElement="blocked_flow">
        <di:waypoint x="635" y="215" />
        <di:waypoint x="635" y="290" />
        <di:waypoint x="722" y="290" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>